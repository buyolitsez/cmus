#!/usr/bin/env python3
"""Rate the albums of the bucket tracks selected in cmus, 1 to 10, in state/ratings.json.

Run it from cmus as ":run cmus-b2-rate 8", or bind keys to it. The rating goes on
top of the bucket copy as "pending"; tools/sync-ratings.py of b2-player then
writes it to the listening diary. cmus-b2 --likes reloads the ratings in cmus.
Runs in the background and reports in the cmus command line when done.
"""
import gzip
import json
import os
import subprocess
import sys
import time

REMOTE = "b2music:buyolitsez-music/state/ratings.json"
OUT = os.path.expanduser("~/.cache/cmus-b2")


def cmus(*cmd):
    return subprocess.run(["cmus-remote", *cmd], capture_output=True, text=True).stdout


def clean(s):
    """As contrib/cmus-b2 writes the album artist and album."""
    return " ".join(str(s).split())


def option(name):
    for line in cmus("-Q").splitlines():
        if line.startswith(f"set {name} "):
            return line[len(f"set {name} "):]
    return ""


def main():
    rating = int(sys.argv[1])
    if not 1 <= rating <= 10:
        raise ValueError("the rating is 1 to 10")
    bucket = option("bucket_dir")
    with gzip.open(os.path.join(OUT, "catalog.json.gz"), "rt", encoding="utf-8") as f:
        catalog = json.load(f)
    # cmus filename -> album, as contrib/cmus-b2 names the tracks
    albums = {}
    for al in catalog["albums"]:
        for t in al["tracks"]:
            path = t["path"]
            albums[(os.path.dirname(path), t.get("track")) if "start" in t else path] = al

    selected = {}
    for f in sys.argv[2:]:
        if f.startswith("cue://"):
            cue, n = f[len("cue://"):].rsplit("/", 1)
            key = (os.path.relpath(os.path.dirname(cue), bucket), int(n))
        else:
            key = os.path.relpath(f, bucket)
        if key in albums:
            selected[albums[key]["id"]] = albums[key]
    if not selected:
        cmus("-C", "echo No bucket tracks selected")
        return 1

    # Show the rating in cmus right away; the upload below takes a few seconds.
    ratings_file = os.path.join(OUT, "ratings")
    try:
        with open(ratings_file, "rb") as f:
            fields = f.read().decode().split("\0")[:-1]
    except FileNotFoundError:
        fields = []
    shown = {(fields[i], fields[i + 1]): fields[i + 2] for i in range(0, len(fields) - 2, 3)}
    for al in selected.values():
        shown[(clean(al["artist"]), clean(al["title"]))] = str(rating)
    with open(ratings_file + ".tmp", "wb") as f:
        f.write("".join(f"{artist}\0{album}\0{r}\0" for (artist, album), r in shown.items()).encode())
    os.replace(ratings_file + ".tmp", ratings_file)
    what = next(iter(selected.values()))["title"] if len(selected) == 1 else f"{len(selected)} albums"
    cmus("-C", f"set album_ratings_file={ratings_file}")
    cmus("-C", f"echo Rated {rating}: {what}")

    r = subprocess.run(["rclone", "cat", REMOTE], capture_output=True)
    state = json.loads(r.stdout) if r.returncode == 0 and r.stdout else {"version": 1, "albums": {}}
    now = int(time.time() * 1000)
    for aid in selected:
        state["albums"][aid] = {"rating": rating, "time": now, "pending": True}
    subprocess.run(["rclone", "rcat", REMOTE], input=json.dumps(state, indent=1, ensure_ascii=False).encode(), check=True)
    subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "cmus-b2"), "--likes"], check=True)
    return 0


if __name__ == "__main__":
    # cmus waits for the command, so the upload goes on in the background
    if os.fork():
        sys.exit(0)
    os.setsid()
    try:
        sys.exit(main())
    except Exception as e:
        cmus("-C", f"echo cmus-b2-rate failed: {e}")
        sys.exit(1)
