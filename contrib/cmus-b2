#!/usr/bin/env python3
"""Add the music from the b2-player bucket to the cmus library.

The bucket's music/ is expected to be mounted with rclone (see
contrib/rclone-b2music.service). The catalog of the b2-player app gives the
tags, so cmus adds the tracks without reading the files over the network.

Writes to ~/.cache/cmus-b2:
  library.m3u  tagged playlist for ":add" (filename, duration, mtime, tags)
  likes        liked tracks for the lastfm_loved_file option
  lyrics/      lyrics from the bucket for contrib/cmus-b2-lyrics
If cmus is running, adds the library and reloads the likes.

With --likes only state/likes.json is fetched and the likes reloaded when they
changed; contrib/cmus-b2-likes.timer runs that every minute.
"""
import argparse
import gzip
import json
import os
import subprocess
import sys

p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
p.add_argument("--remote", default="b2music:buyolitsez-music", help="rclone path of the bucket")
p.add_argument("--mount", default="~/b2music", help="where music/ of the bucket is mounted")
p.add_argument("--out", default="~/.cache/cmus-b2")
p.add_argument("--likes", action="store_true", help="only fetch and reload the likes")
a = p.parse_args()
mount = os.path.expanduser(a.mount)
out = os.path.expanduser(a.out)

if not a.likes and (not os.path.isdir(mount) or not os.listdir(mount)):
    sys.exit(f"{mount} is not mounted: systemctl --user start rclone-b2music")
os.makedirs(out, exist_ok=True)
# rclone copies a file only when it changed
for name in ("state/likes.json",) if a.likes else ("catalog.json.gz", "state/likes.json"):
    subprocess.run(["rclone", "copyto", f"{a.remote}/{name}", os.path.join(out, os.path.basename(name))], check=True)

with gzip.open(os.path.join(out, "catalog.json.gz"), "rt", encoding="utf-8") as f:
    catalog = json.load(f)
with open(os.path.join(out, "likes.json"), encoding="utf-8") as f:
    likes = json.load(f)
added, removed = set(likes.get("added", [])), set(likes.get("removed", []))


def clean(s):
    return " ".join(str(s).split())


cues = {}


def cue_of(d):
    """The .cue file the catalog split a single-file rip by."""
    if d not in cues:
        names = sorted(n for n in os.listdir(os.path.join(mount, d)) if n.lower().endswith(".cue"))
        cues[d] = os.path.join(mount, d, names[0]) if names else None
    return cues[d]


lines, loved = [], {}
for al in catalog["albums"]:
    for t in al["tracks"]:
        path = t["path"]
        artist = t.get("artist") or al["artist"]
        tid = path if "start" not in t else f"{path}#{float(t['start'])}"
        if (t.get("liked") or tid in added) and tid not in removed and clean(artist) and clean(t["title"]):
            loved[(artist.casefold(), t["title"].casefold())] = (artist, t["title"])
        if a.likes:
            continue
        filename = os.path.join(mount, path)
        if "start" in t:
            cue = cue_of(os.path.dirname(path))
            if not cue or "track" not in t:
                continue
            filename = f"cue://{cue}/{t['track']}"
        tags = {"artist": artist, "albumartist": al["artist"], "album": al["title"], "title": t["title"],
                "tracknumber": t.get("track"), "discnumber": t.get("disc"), "date": al.get("year"),
                "genre": al.get("genre")}
        fields = [filename, str(round(t["duration"])), str(t.get("mtime", 0))]
        for k, v in tags.items():
            if v is not None and clean(v):
                fields += [k, clean(v)]
        lines.append("\t".join(fields))

likes_file = os.path.join(out, "likes")
likes = b"".join(f"{clean(artist)}\0{clean(title)}\0".encode() for artist, title in loved.values())
try:
    with open(likes_file, "rb") as f:
        likes_changed = f.read() != likes
except FileNotFoundError:
    likes_changed = True
if likes_changed:
    with open(likes_file + ".tmp", "wb") as f:
        f.write(likes)
    os.replace(likes_file + ".tmp", likes_file)
cmus_running = subprocess.run(["cmus-remote", "-C", "echo"], capture_output=True).returncode == 0
if a.likes:
    if likes_changed and cmus_running:
        subprocess.run(["cmus-remote", "-C", f"set lastfm_loved_file={likes_file}"], check=True)
    sys.exit()

# lyrics from tags, as contrib/cmus-b2-lyrics reads them
lyrics_json = os.path.join(out, "lyrics-json")
subprocess.run(["rclone", "sync", f"{a.remote}/lyrics", lyrics_json], check=True)
for al in catalog["albums"]:
    try:
        with open(os.path.join(lyrics_json, al["id"] + ".json"), encoding="utf-8") as f:
            texts = json.load(f)
    except FileNotFoundError:
        continue
    for path, text in texts.items():
        lrc = os.path.join(out, "lyrics", path + ".lrc")
        os.makedirs(os.path.dirname(lrc), exist_ok=True)
        with open(lrc, "w", encoding="utf-8") as f:
            f.write(text)

library = os.path.join(out, "library.m3u")
with open(library + ".tmp", "w", encoding="utf-8") as f:
    f.write("\n".join(lines) + "\n")
os.replace(library + ".tmp", library)
print(f"{len(lines)} tracks, {len(loved)} liked")

if cmus_running:
    subprocess.run(["cmus-remote", "-l", library], check=True)
    subprocess.run(["cmus-remote", "-C", f"set lastfm_loved_file={likes_file}"], check=True)
