def discogs(url):
    m = re.search(r"discogs\.com/(?:[a-z]{2}/)?(release|master)/(\d+)", url)
    if not m:
        return "Not a Discogs release or master link."
    try:
        r = requests.get(f"https://api.discogs.com/{m[1]}s/{m[2]}", headers={"User-Agent": "cmus-b2-release/1.0"},
                         timeout=30)
        r.raise_for_status()
    except requests.RequestException as e:
        return f"Discogs did not answer: {e}"
    d = r.json()
    keep = ("title", "artists", "year", "released", "country", "labels", "formats", "genres", "styles", "tracklist",
            "extraartists", "notes")
    return json.dumps({k: d[k] for k in keep if d.get(k)}, ensure_ascii=False)[:20000]


def ask_claude(messages, fields):
    """Claude's answer to messages, which it may look up on the web: the fields as a dict, or notes in words
    when fields is False (with the answer format set, Claude tends to skip the search)."""
    load_env()
    client = anthropic.Anthropic()
    fmt = {"format": {"type": "json_schema", "schema": SCHEMA}} if fields else {}
    while True:
        r = client.beta.messages.create(
            model=MODEL, max_tokens=16000, messages=messages,
            tools=[{"type": "web_search_20260209", "name": "web_search", "max_uses": 30}, DISCOGS],
            output_config={"effort": "low", **fmt},
            betas=["server-side-fallback-2026-07-01"], fallbacks="default")
        log_usage(r.usage)
        messages.append({"role": "assistant", "content": r.content})
        if r.stop_reason == "pause_turn":  # the web search goes on
            continue
        if r.stop_reason == "tool_use":
            messages.append({"role": "user", "content": [
                {"type": "tool_result", "tool_use_id": b.id, "content": discogs(b.input.get("url", ""))}
                for b in r.content if b.type == "tool_use"]})
            continue
        if r.stop_reason != "end_turn":
            raise RuntimeError(f"Claude did not answer ({r.stop_reason})")
        text = [b.text for b in r.content if b.type == "text"]
        return json.loads(text[-1]) if fields else "\n".join(text)


CACHE = os.path.join(OUT, "release-cache.json")
CACHE_DAYS = 30


def load_cache():
    """The checks of the files (by size and mtime) and Claude's drafts of the releases, of the last 30 days."""
    try:
        with open(CACHE, encoding="utf-8") as f:
            c = json.load(f)
    except (FileNotFoundError, ValueError):
        c = {}
    old = time.time() - CACHE_DAYS * 86400
    return {k: {x: v for x, v in c.get(k, {}).items() if v["time"] > old} for k in ("probe", "drafts")}


def save_cache(c):
    os.makedirs(OUT, exist_ok=True)
    with open(CACHE + ".tmp", "w", encoding="utf-8") as f:
        json.dump(c, f, ensure_ascii=False)
    os.replace(CACHE + ".tmp", CACHE)


def save_draft(key, **fields):
    c = load_cache()
    c["drafts"][key] = {**c["drafts"].get(key, {}), **fields, "time": time.time()}
    save_cache(c)


class Release:
    def __init__(self, mount, dirs):
        self.mount, self.dirs = mount, dirs
        self.files = []  # paths relative to the mount
        for d in dirs:
            for root, subdirs, names in os.walk(os.path.join(mount, d)):
                subdirs.sort()
                for n in sorted(names):
                    if not n.startswith(".") and ".sync-conflict-" not in n and os.path.splitext(n)[1].lower() in KEEP_EXT:
                        self.files.append(os.path.relpath(os.path.join(root, n), mount))
        self.audio = [f for f in self.files if os.path.splitext(f)[1].lower() in AUDIO_EXT]
        self.size = sum(os.path.getsize(os.path.join(mount, f)) for f in self.files)
        cache = load_cache()
        stamps = {f: [os.stat(os.path.join(mount, f)).st_size, os.stat(os.path.join(mount, f)).st_mtime]
                  for f in self.audio}
        self.tracks = {f: cache["probe"][f]["data"] for f in self.audio
                       if cache["probe"].get(f, {}).get("stamp") == stamps[f]}
        todo = [f for f in self.audio if f not in self.tracks]
        if len(todo) < len(self.audio):
            print(f"{len(self.audio) - len(todo)} files were checked before and did not change.")
        # 4 files at a time: faster over the mount, and arch overheats on all its cores
        with concurrent.futures.ThreadPoolExecutor(4) as pool:
            jobs = {pool.submit(probe, os.path.join(mount, f)): f for f in todo}
            for i, job in enumerate(concurrent.futures.as_completed(jobs), 1):
                print(f"\r\x1b[KChecking {i}/{len(todo)}: {os.path.basename(jobs[job])}", end="", flush=True)
                f = jobs[job]
                self.tracks[f] = job.result()
                cache["probe"][f] = {"stamp": stamps[f], "time": time.time(), "data": self.tracks[f]}
        if todo:
            print()
            save_cache(cache)
        self.tracks = {f: self.tracks[f] for f in self.audio}
        t = list(self.tracks.values())
        self.codecs = sorted({x["codec"] for x in t})
        self.lossless = all(c in LOSSLESS for c in self.codecs)
        self.duration = sum(x["duration"] for x in t)
        mid = sorted(self.audio, key=lambda f: self.tracks[f]["duration"])[len(self.audio) // 2]
        self.cutoff = 19000 if self.lossless else 17500
        self.drop = band_drop(os.path.join(mount, mid), self.cutoff)

    def codec(self):
        return "/".join(CODEC.get(c, c.upper()) for c in self.codecs)

    def bitrate(self):
        """'lossless', '320 kbps' (CBR) or 'VBR ~245 kbps'."""
        if self.lossless:
            return "lossless"
        rates = {x["stream_kbps"] for x in self.tracks.values()}
        if len(rates) == 1 and self.codecs == ["mp3"]:
            return f"{rates.pop()} kbps"
        avg = sum(x["kbps"] * x["duration"] for x in self.tracks.values()) / self.duration
        return f"VBR ~{avg:.0f} kbps"

    def specs(self):
        t = list(self.tracks.values())
        bits = sorted({x["bits"] for x in t if x["bits"]}) if self.lossless else []
        ch = {1: "mono", 2: "stereo"}
        return " / ".join(filter(None, [
            "/".join(f"{b} bit" for b in bits), "/".join(khz(r) for r in sorted({x["rate"] for x in t})),
            "/".join(ch.get(c, f"{c} ch") for c in sorted({x["channels"] for x in t}))]))

    def warnings(self):
        out = []
        t = self.tracks
        broken = [f for f in t if t[f]["errors"]]
        if broken:
            out.append("decode errors in: " + ", ".join(os.path.basename(f) for f in broken))
        if any(c in ("opus", "vorbis") for c in self.codecs) or any("youtube" in (x["comment"] + x["album"]).lower() for x in t.values()):
            out.append("looks like a YouTube rip: rutracker takes no re-encodes and frowns on YouTube sources")
        avg = sum(x["kbps"] for x in t.values()) / len(t)
        if not self.lossless and avg < 192:
            out.append(f"average bitrate {avg:.0f} kbps is below the usual minimum of 192")
        if self.drop is not None and self.drop > 45:
            out.append(f"nothing above {self.cutoff / 1000:g} kHz: made from a lossy file of lower quality, "
                       "and the spectrograms in the post show it")
        return out

    def facts(self):
        lines = []
        for f, x in self.tracks.items():
            lines.append(f"{f}\t{x['artist']}\t{x['albumartist']}\t{x['album']}\t{x['date']}\t{x['genre']}\t{x['title']}\t"
                         f"{mmss(x['duration'])}")
        return (f"Folders in my library (genre/artist/album): {', '.join(self.dirs)}\n"
                f"Codec {self.codec()}, {self.bitrate()}, {self.specs()}\n"
                f"Tracks (path, artist, album artist, album, year, genre tags, title, length):\n" + "\n".join(lines) +
                f"\nOther files (path, size):\n{self.others() or 'none'}\n"
                f"Checks found: {'; '.join(self.warnings()) or 'nothing wrong'}")

    def others(self):
        """The files besides the tracks, with what a .cue refers to and whether it is there."""
        lines = []
        for f in self.files:
            if f in self.tracks:
                continue
            lines.append(f"{f}\t{described(os.path.join(self.mount, f))}")
            if f.lower().endswith(".cue"):
                with open(os.path.join(self.mount, f), encoding="utf-8", errors="replace") as c:
                    for ref in re.findall(r'^\s*FILE\s+"?(.+?)"?\s+\w+\s*$', c.read(), re.M):
                        there = os.path.exists(os.path.join(self.mount, os.path.dirname(f), ref))
                        lines.append(f"  refers to {ref}: {'there' if there else 'NOT in the folder'}")
        return "\n".join(lines)

    def tracklist(self):
        out = []
        groups = {}
        for f in self.audio:  # an album, or a disc of it, per group
            groups.setdefault(os.path.dirname(f), []).append(f)
        for d, fs in groups.items():
            if len(groups) > 1:
                x = self.tracks[fs[0]]
                head = x["album"] or os.path.basename(d)
                if x["date"] and len(self.dirs) > 1:
                    head += f" ({x['date']})"
                if DISC_DIR.match(os.path.basename(d)):
                    head += " — " + os.path.basename(d)
                out.append(f"\n[b]{head}[/b]")
            for i, f in enumerate(fs, 1):
                x = self.tracks[f]
                title = x["title"] or re.sub(r"^\d+[\s.\-_]*", "", os.path.splitext(os.path.basename(f))[0])
                out.append(f"{i} {title} [{mmss(x['duration'])}]")
        return "\n".join(out).strip("\n")

    def quality(self):
        rows = []
        width = max(len(os.path.basename(f)) for f in self.audio)
        for f in self.audio:
            x = self.tracks[f]
            bits = f"{x['bits']} bit  " if self.lossless and x["bits"] else ""
            check = "flac -t OK" if x["codec"] == "flac" and not x["errors"] else ""
            err = "decode errors" if x["errors"] else "decoded without errors"
            rows.append(f"{os.path.basename(f).ljust(width)}  {CODEC.get(x['codec'], x['codec'])}  "
                        f"{x['kbps']:6.1f} kbps  {bits}{khz(x['rate'])}  {err}{'  ' + check if check else ''}")
        return "\n".join(rows)


def title_of(r, x):
    rip = " (tracks)" if r.lossless else ""
    web = "[WEB] " if x["web"] == "yes" else ""
    return f"({x['genre']}) {web}{x['artist']} - {x['album']} - {x['year']}, {r.codec()}{rip}, {r.bitrate()}"


def post(r, x, cover="ОБЛОЖКА", spectra=()):
    scans = len([f for f in r.files if os.path.splitext(f)[1].lower() in IMAGE_EXT]) > len(r.dirs)
    lines = [f"[size=24]{x['artist']} / {x['album']}[/size]", "", f"[img=right]{cover}[/img]", "",
             f"[b]Жанр[/b]: {x['genre']}",
             f"[b]Страна исполнителя (группы)[/b]: {x['country']}",
             f"[b]Год издания[/b]: {x['year']}",
             f"[b]Аудиокодек[/b]: {r.codec()}",
             "[b]Тип рипа[/b]: tracks",
             f"[b]Битрейт аудио[/b]: {r.bitrate()}",
             f"[b]Характеристики[/b]: {r.specs()}",
             f"[b]Продолжительность[/b]: {hhmmss(r.duration)}",
             f"[b]Размер раздачи[/b]: {r.size / 2**20:.1f} MB",
             "[b]Источник[/b]: " + (f"[url={x['source_url']}]{'WEB' if x['web'] == 'yes' else 'официальная страница'}[/url]"
                                     if x["source_url"] else "WEB" if x["web"] == "yes" else "—"),
             f"[b]Наличие сканов в содержимом раздачи[/b]: {'да' if scans else 'нет'}",
             "[b]Треклист[/b]:", r.tracklist(), "",
             '[spoiler="Скриншот проверки качества материала"]', "[code]", r.quality(), "[/code]"]
    if spectra:
        lines += ["Спектрограммы:"] + [f"[url={full}][img]{thumb}[/img][/url]" for full, thumb in spectra]
    lines.append("[/spoiler]")
    if x["about"]:
        lines += ["", '[spoiler="Об альбоме (сборнике)"]', x["about"], "[/spoiler]"]
    if x["lineup"]:
        lines += ["", '[spoiler="Состав"]', x["lineup"], "[/spoiler]"]
    return "\n".join(lines) + "\n"


def make_torrent(r, name, out):
    """The .torrent of the release's files under the folder name. Returns the map of its paths to the files."""
    def inside(f):  # the file's path in the release: below the album folder, or from it for several albums
        d = next(d for d in r.dirs if f.startswith(d + "/"))
        return "/".join(f.split("/")[d.count("/") + (1 if len(r.dirs) == 1 else 0):])

    paths = {os.path.join(name, inside(f)): f for f in r.files}
    with tempfile.TemporaryDirectory() as tmp:  # the release as links to the files on the mount
        fs = lt.file_storage()
        for path, f in paths.items():
            os.makedirs(os.path.dirname(os.path.join(tmp, path)), exist_ok=True)
            os.symlink(os.path.join(r.mount, f), os.path.join(tmp, path))
            fs.add_file(path, os.path.getsize(os.path.join(r.mount, f)))
        ct = lt.create_torrent(fs, 0, lt.create_torrent.v1_only)
        for tier, url in enumerate(ANNOUNCE):
            ct.add_tracker(url, tier)
        print("Hashing the files (read from the bucket)...")
        lt.set_piece_hashes(ct, tmp)
        t = ct.generate()
    t[b"info"][b"private"] = 0  # as rutracker's own .torrent has it, so the info hash stays the same
    with open(out, "wb") as f:
        f.write(lt.bencode(t))
    return paths


def files_of(path):
    fs = lt.torrent_info(path).files()
    return [(fs.file_path(i), fs.file_size(i)) for i in range(fs.num_files())]


def wait_for_rutracker(ours, paths, since):
    """Waits for the .torrent downloaded from rutracker (same files as ours) in ~/Downloads and seeds it."""
    want = sorted(files_of(ours))
    print(f"Waiting for the .torrent from rutracker in {DOWNLOADS} to seed it from the bucket (Enter stops waiting)...")
    while True:
        for f in glob.glob(os.path.join(DOWNLOADS, "*.torrent")):
            try:
                if os.path.getmtime(f) < since or sorted(files_of(f)) != want:
                    continue
            except RuntimeError:  # still being written
                continue
            seed_map = {str(i): p for i, (path, _) in enumerate(files_of(f)) for p in [paths[path]]}
            with tempfile.NamedTemporaryFile("w", suffix=".json", encoding="utf-8") as m:
                json.dump(seed_map, m, ensure_ascii=False)
                m.flush()
                here = os.path.dirname(os.path.realpath(__file__))
                subprocess.run([os.path.join(here, "cmus-b2-seed"), "add", f, m.name], check=True)
            return f"Seeding {os.path.basename(f)} from the bucket (view 9)."
        if select.select([sys.stdin], [], [], 2)[0]:
            sys.stdin.readline()
            return "Not seeding: download the .torrent from the topic and add it in view 9 with a, or press S again."


def release(mount, dirs, out_root):
    r = Release(mount, dirs)
    for w in r.warnings():
        print("Warning:", w)
    with tempfile.TemporaryDirectory(prefix="cmus-b2-release-") as work:
        publish(r, mount, work, out_root)


def wrap(text, first="  • ", rest="    "):
    width = max(40, shutil.get_terminal_size().columns - 2)
    return textwrap.fill(text, width, initial_indent=first, subsequent_indent=rest)


def show_notes(notes, seen=()):
    """Claude's notes as a numbered list, a point per line (or per sentence, if it wrote one paragraph), without
    the points already seen. Returns the points."""
    notes = html.unescape(notes).strip()
    if not notes:
        return []
    points = [p for p in notes.splitlines() if p.strip()]
    if len(points) == 1:
        points = re.split(r"(?<=[.!?])\s+(?=[A-ZА-ЯЁ])", points[0])
    points = [q for q in (re.sub(r"^\s*(?:[-•*]|\d+[.)])\s*", "", p) for p in points) if q not in seen]
    if not points:
        return []
    print("\n\x1b[1mClaude:\x1b[0m")
    for i, p in enumerate(points, 1):
        print(wrap(p, f"{i:>3}. ", "     "))
    return points


def edited_files(r, edit):
    """The tracks an edit is for: the file, or the tracks in the folder."""
    p = edit["path"].strip("/")
    return [f for f in r.audio if f == p or f.startswith(p + "/")]


def show_changes(r, x):
    old, new = "\x1b[31m", "\x1b[32m"
    edits = [e for e in x.get("tag_edits", []) if any(  # not those made already (Claude repeats them in each draft)
        r.tracks[f].get(e["tag"], "") != (e["value"][:4] if e["tag"] == "date" else e["value"]) for f in edited_files(r, e))]
    if edits:
        print("\n\x1b[1mChanges in the library\x1b[0m (the bucket, cmus and the phone get them):")
        for e in edits:
            fs = edited_files(r, e)
            was = sorted({r.tracks[f].get(e["tag"], "") for f in fs})
            where = e["path"].strip("/").removeprefix(os.path.commonpath(r.dirs) + "/") if len(r.dirs) > 1 else \
                os.path.relpath(e["path"].strip("/"), r.dirs[0])
            what = f"{where} ({len(fs)} tracks)" if len(fs) > 1 else where
            print(wrap(f"{what}: {e['tag']} {old}{' / '.join(w or '—' for w in was)}\x1b[0m → {new}{e['value']}\x1b[0m"))
    names = [n for n in x.get("renames", []) if n["name"] and "/" not in n["name"] and any(f == n["path"].strip("/") or f.startswith(n["path"].strip("/") + "/")
                                                       for f in r.files)]
    gone = sorted({d["path"].strip("/") for d in x.get("deletions", [])} & (set(r.files) - set(r.audio)))
    names = [n for n in names if n["path"].strip("/") not in gone]
    added = [a for a in x.get("additions", []) if os.path.isfile(a["source"])
             and os.path.dirname(os.path.realpath(a["source"])) == os.path.realpath(DOWNLOADS)
             and any(a["path"].strip("/").startswith(d + "/") for d in r.dirs) and ".." not in a["path"]
             and a["path"].strip("/") not in r.files]
    if names:
        print("\n\x1b[1mRenames in the library\x1b[0m (likes, playlists, history and ratings move along):")
        for n in names:
            print(wrap(f"{old}{os.path.basename(n['path'].strip('/'))}\x1b[0m → {new}{n['name']}\x1b[0m"))
    if gone:
        print("\n\x1b[1mDelete from the library\x1b[0m (the bucket keeps them hidden for 30 days):")
        for f in gone:
            print(wrap(f"{old}{f.removeprefix(os.path.commonpath(r.dirs) + '/')}\x1b[0m"))
    if added:
        print("\n\x1b[1mAdd to the library\x1b[0m:")
        for a in added:
            print(wrap(f"{os.path.basename(a['source'])} → {new}{a['path'].strip('/').removeprefix(os.path.commonpath(r.dirs) + '/')}\x1b[0m"))
    return edits, names, gone, added


def delete_files(r, gone):
    """Hides the files in the bucket, puts their local copies in the trash and leaves them out of the release."""
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".txt") as lst:
        lst.write("\n".join(gone) + "\n")
        lst.flush()
        subprocess.run(["rclone", "delete", f"{REMOTE}/music", "--files-from-raw", lst.name], check=True)
    for root in {os.path.expanduser("~/Music"), option("download_dir")} - {""}:
        for f in gone:
            if os.path.exists(os.path.join(root, f)):
                trash(os.path.join(root, f))
    for d in {os.path.dirname(f) for f in gone}:
        subprocess.run(["rclone", "rc", "vfs/refresh", f"dir={d}"], capture_output=True)
    r.files = [f for f in r.files if f not in gone]
    r.size = sum(os.path.getsize(os.path.join(r.mount, f)) for f in r.files)
    print(f"Deleted {len(gone)} files.")


def add_files(r, added):
    """Copies the files of ~/Downloads into the album folders in the bucket and the release."""
    for a in added:
        subprocess.run(["rclone", "copyto", a["source"], f"{REMOTE}/music/{a['path'].strip('/')}"], check=True)
    for d in {os.path.dirname(a["path"].strip("/")) for a in added}:
        subprocess.run(["rclone", "rc", "vfs/refresh", f"dir={d}"], capture_output=True)
    r.files = sorted(set(r.files) | {a["path"].strip("/") for a in added})
    r.size = sum(os.path.getsize(os.path.join(r.mount, f)) for f in r.files)
    print(f"Added {len(added)} files.")


def apply_edits(r, edits):
    """Writes the tag edits into the files as K does (contrib/cmus-b2-tag) and updates the release's tracks."""
    plan = [{"path": f, "tag": e["tag"], "value": e["value"]} for e in edits for f in edited_files(r, e)]
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".json") as fh:
        json.dump(plan, fh, ensure_ascii=False)
        fh.flush()
        here = os.path.dirname(os.path.realpath(__file__))
        if subprocess.run([os.path.join(here, "cmus-b2-tag"), "--edits", fh.name,
                           *[os.path.join(r.mount, x["path"]) for x in plan]]).returncode:
            raise SystemExit("The tags were not changed.")
    for x in plan:
        r.tracks[x["path"]][x["tag"]] = x["value"][:4] if x["tag"] == "date" else x["value"]
    r.size = sum(os.path.getsize(os.path.join(r.mount, f)) for f in r.files)


def apply_renames(r, names):
    """Renames the folders and files in the library (contrib/cmus-b2-rename) and in the release."""
    pairs = [(n["path"].strip("/"), os.path.join(os.path.dirname(n["path"].strip("/")), n["name"])) for n in names]
    here = os.path.dirname(os.path.realpath(__file__))
    print(f"\nRenaming {len(pairs)} folders and files in the library...", flush=True)
    if subprocess.run([os.path.join(here, "cmus-b2-rename"), *[x for pair in pairs for x in pair]]).returncode:
        raise SystemExit("Not renamed.")

    def moved(f):
        for old, new in pairs:
            if f == old or f.startswith(old + "/"):
                return new + f[len(old):]
        return f

    r.dirs, r.files, r.audio = [moved(d) for d in r.dirs], [moved(f) for f in r.files], [moved(f) for f in r.audio]
    r.tracks = {moved(f): x for f, x in r.tracks.items()}


def publish(r, mount, work, out_root):
    """Claude's draft until accepted, then the images, the .torrent, the clipboard and the wait for rutracker."""
    cover = cover_of(r.files, mount, os.path.join(work, "cover.jpg"))
    mid = r.audio[len(r.audio) // 2]
    spectra = [spectrogram(os.path.join(mount, f), os.path.join(work, f"spectrum-{i}.png"))
               for i, f in enumerate(dict.fromkeys([r.audio[0], mid]), 1)]

    messages = [{"role": "user", "content": f"""I am making a rutracker.org release of music from my library.
<facts>
{r.facts()}
</facts>
Images, .cue and .log files in my Downloads folder of the last 3 days (path, size):
<downloads>
{downloads() or 'none'}
</downloads>
rutracker's music forums (each has lossy and lossless subforums):
<forums>
{FORUMS}
</forums>
First look the release up on the web (its official page, Discogs, RYM, Bandcamp, the label): the artist's
country, genres as RYM or Discogs give them, the official page, line-up and a few facts about the album. When the
search has given the Discogs links of the albums, call the discogs tool on the master (or release) link of each
album, since the search results do not show the genres and credits. RYM lets nothing read its pages: take its genres from the search
results, and say so if they are not there.
Answer with short notes of what you found and where."""}]
    key = "\n".join(r.dirs)  # the draft of these albums; its fields only while the facts are the same
    # the files Claude can add count too: a cover downloaded since the last draft makes a new one
    facts = hashlib.sha1((r.facts() + downloads()).encode("utf-8")).hexdigest()
    draft = load_cache()["drafts"].get(key, {})
    seen = draft.get("seen", [])  # the points of the notes I left as they are: not shown again
    if draft.get("research"):
        messages.append({"role": "assistant", "content": draft["research"]})
    else:
        print("Claude is looking the album up...")
        save_draft(key, research=ask_claude(messages, False))
    messages.append({"role": "user", "content": """Now fill in the fields of the topic. Prefer the tags where they
say it; write only what you found or what the files show, and leave a field empty rather than guess. I may answer
with corrections in my own words, also asking you to change tags or names: then answer with all the fields again,
with the changes I asked for in tag_edits, renames, deletions and additions (fill the fields as they will be after the changes). A file of <downloads> that an album lacks (its cover, say)
put in additions straight away: I see the changes before they are made.""" + (
        "\nIn the notes, leave out what I have already seen and left as it is:\n" + "\n".join(f"- {p}" for p in seen)
        if seen else "")})
    if draft.get("facts") == facts and draft.get("fields"):
        x = draft["fields"]
        messages.append({"role": "assistant", "content": json.dumps(x, ensure_ascii=False)})
        print("\nThe draft from the last time (the files did not change):")
    else:
        x = ask_claude(messages, True)
    answer, points, images, out, torrent = "", [], {}, None, None  # images: the urls of the uploaded ones, by file
    while True:  # the draft until accepted, and again when I write to Claude after accepting it
        if not answer:
            save_draft(key, facts=facts, fields=x)
            print("\n" + post(r, x) + "\nTitle: " + title_of(r, x) + f"\nForum: {x['forum']}")
            points = show_notes(x["notes"], seen)
            edits, names, gone, added = show_changes(r, x)
            answer = ask("\nEnter: accept, q: quit, numbers of the points to fix (1 3), or tell Claude what to change: ")
            if answer.lower() == "q":
                return
        if answer:
            picked = [int(n) for n in re.findall(r"\d+", answer)]
            if re.fullmatch(r"[\d\s,]+", answer) and all(1 <= n <= len(points) for n in picked):
                answer = ("Fix these points of your notes yourself, the way you think right (tags, names, adding or "
                          "deleting files, the fields):\n" + "\n".join(f"- {points[n - 1]}" for n in picked))
            else:
                picked = []
            seen += [p for i, p in enumerate(points, 1) if i not in picked and p not in seen]
            save_draft(key, seen=seen)
            if seen:
                answer += ("\n\nIn the notes, leave out what I have already seen and left as it is:\n"
                           + "\n".join(f"- {p}" for p in seen))
            messages.append({"role": "user", "content": answer})
            print("Asking Claude...")
            x, answer = ask_claude(messages, True), ""
            continue

        if edits:
            apply_edits(r, edits)
        if gone:
            delete_files(r, gone)
        if added:
            add_files(r, added)
            cover = cover_of(r.files, mount, os.path.join(work, "cover.jpg"))
            images.pop(cover, None)
        if names:
            apply_renames(r, names)
        title = title_of(r, x)
        name = re.sub(r'[\\/:*?"<>|]', "_", f"{x['artist']} - {x['album']} ({x['year']}) [{r.codec()}]").strip()
        if out and out != os.path.join(out_root, name):  # the files of the draft before
            shutil.rmtree(out, ignore_errors=True)
        out = os.path.join(out_root, name)
        os.makedirs(out, exist_ok=True)
        todo = [f for f in ([cover] if cover else []) + spectra if f not in images]
        if todo:
            print("Uploading the cover and the spectrograms...")
            images.update(zip(todo, upload_images(todo)))
        text = post(r, x, images[cover][0] if cover else "ОБЛОЖКА", [images[f] for f in spectra])
        since = time.time()
        if torrent and os.path.exists(torrent):  # of the draft before
            os.remove(torrent)
        torrent = os.path.join(out, title.replace("/", "_") + ".torrent")
        paths = make_torrent(r, name, torrent)
        for fn, s in (("title.txt", title + "\n"), ("description.txt", text)):
            with open(os.path.join(out, fn), "w", encoding="utf-8") as f:
                f.write(s)

        latin = re.search(r"\[(.+)\]$", x["artist"])  # rutracker's search finds the Latin name better
        search = f"{latin.group(1) if latin else x['artist']} {x['album']}"
        subprocess.Popen(["xdg-open", "https://rutracker.org/forum/tracker.php?nm=" + urllib.parse.quote(search)],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"\nForum: {x['forum']}\nTorrent: {torrent}\nFirefox shows the rutracker search, to check the album is not there yet.")
        subprocess.run(["wl-copy", title], stdin=subprocess.DEVNULL)
        answer = ask("The title is in the clipboard. Enter copies the description, or tell Claude what to change: ")
        if answer:
            continue
        subprocess.run(["wl-copy", text], stdin=subprocess.DEVNULL)
        answer = ask("The description is in the clipboard. Enter copies the path of the .torrent, "
                     "or tell Claude what to change: ")
        if answer:
            continue
        subprocess.run(["wl-copy", torrent], stdin=subprocess.DEVNULL)
        print(wait_for_rutracker(torrent, paths, since))
        return


def picard_albums(bucket, albums):
    """Tag the albums' files with Picard as K does in cmus; CUE images (one file, several tracks) are left out."""
    files = [p for ps in albums for p in ps if ps.count(p) == 1]
    subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "cmus-b2-tag"),
                    *[os.path.join(bucket, p) for p in files]])


def main():
    bucket = option("bucket_dir")
    if not bucket:
        done("Set bucket_dir in cmus.", 1)
    sizes, paths = {}, {}  # album folder (with its CD folders) -> size and track files, from the catalog cmus-b2 keeps
    with gzip.open(os.path.join(OUT, "catalog.json.gz"), "rt", encoding="utf-8") as f:
        for al in json.load(f)["albums"]:
            for t in al["tracks"]:
                d = album_of(t["path"])
                sizes[d] = sizes.get(d, 0) + t.get("size", 0)
                paths.setdefault(d, []).append(t["path"])
    albums = sorted(sizes)
    playing = query().get("file", "")
    key = key_of(playing[len("cue://"):].rsplit("/", 1)[0] if playing.startswith("cue://") else playing,
                 [bucket, option("download_dir")])
    marked = curses.wrapper(pick, "Release on rutracker", [(i, d, sizes[d]) for i, d in enumerate(albums)],
                            at=album_of(key) if key else None, enter="release marked", unit="albums",
                            keys={"t": ("tag in Picard", lambda marked: picard_albums(bucket, [paths[albums[i]] for i in marked]))})
    dirs = [albums[i] for i in marked or []]
    if not dirs:
        return
    groups = [[d] for d in dirs]
    if len(dirs) > 1:
        print("Albums:\n  " + "\n  ".join(dirs))
        if ask(f"One release with all {len(dirs)} albums? [y/N] ").lower() == "y":
            groups = [dirs]
    for g in groups:
        release(bucket, g, os.path.join(DOWNLOADS, "rutracker"))
    done("Done.")



if __name__ == "__main__":
    try:
        main()
    except (Exception, SystemExit) as e:  # keep the window open to read what went wrong
        if not (isinstance(e, SystemExit) and e.code in (None, 0)):
            print(e if isinstance(e, SystemExit) else f"Error: {e!r}")
            ask("Enter to close")
        raise
