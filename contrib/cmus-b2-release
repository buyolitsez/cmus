def ask(prompt):
    try:
        return input(prompt).strip()
    except EOFError:
        sys.exit(1)


def done(msg, code=0):
    ask(f"{msg} Enter closes the window.")
    sys.exit(code)


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def album_of(path):
    d = os.path.dirname(path)
    return os.path.dirname(d) if DISC_DIR.match(os.path.basename(d)) else d


def mmss(s):
    s = round(s)
    return f"{s // 60}:{s % 60:02d}"


def hhmmss(s):
    s = round(s)
    return f"{s // 3600:02d}:{s // 60 % 60:02d}:{s % 60:02d}"


def khz(hz):
    return f"{hz / 1000:g} kHz"


def tag(tags, name):
    v = (tags or {}).get(name)
    return str(v[0]).strip() if v else ""


def probe(path):
    """Codec, bitrate and the rest of one audio file, its tags, and what a full decode found wrong."""
    r = json.loads(run("ffprobe", "-v", "error", "-show_format", "-show_streams", "-of", "json", path).stdout)
    st = next(s for s in r["streams"] if s["codec_type"] == "audio")
    dur = float(r["format"]["duration"])
    errors = run("ffmpeg", "-v", "error", "-i", path, "-map", "0:a", "-f", "null", "-").stderr.strip()
    if st["codec_name"] == "flac" and run("flac", "-t", "-s", path).returncode:
        errors = (errors + "\nflac -t failed").strip()
    try:
        tags = mutagen.File(path, easy=True)
    except mutagen.MutagenError:
        tags = None
    comment = " ".join(str(v) for k, v in (mutagen.File(path) or {}).items() if "comm" in k.lower() or "purl" in k.lower()) if tags else ""
    return {"codec": st["codec_name"], "rate": int(st["sample_rate"]), "channels": st["channels"],
            "bits": int(st.get("bits_per_raw_sample") or st.get("bits_per_sample") or 0),
            "stream_kbps": int(st.get("bit_rate") or 0) // 1000,
            "kbps": int(r["format"]["size"]) * 8 / dur / 1000, "duration": dur, "errors": errors,
            "title": tag(tags, "title"), "artist": tag(tags, "artist"), "album": tag(tags, "album"),
            "date": tag(tags, "date")[:4], "genre": tag(tags, "genre"), "comment": comment}


def cover_of(files, folder, out):
    """The album's cover as a JPEG of at most 500 px in out, or None: the biggest cover/folder/front image, else
    any image, else the art embedded in the first track."""
    images = [f for f in files if os.path.splitext(f)[1].lower() in IMAGE_EXT]
    named = [f for f in images if re.match(r"(cover|folder|front)", os.path.basename(f), re.I)] or images
    src = max(named, key=lambda f: os.path.getsize(os.path.join(folder, f)), default=None)
    args = ["-i", os.path.join(folder, src)] if src else \
        ["-i", os.path.join(folder, next(f for f in files if os.path.splitext(f)[1].lower() in AUDIO_EXT)), "-an"]
    r = run("ffmpeg", "-v", "error", "-y", *args, "-frames:v", "1", "-vf",
            "scale='min(500,iw)':'min(500,ih)':force_original_aspect_ratio=decrease", "-q:v", "2", out)
    return out if r.returncode == 0 and os.path.exists(out) else None


def spectrogram(path, out):
    run("ffmpeg", "-v", "error", "-y", "-i", path, "-lavfi", "showspectrumpic=s=1000x500:legend=1", out)
    return out


def upload_images(paths):
    """Uploads images for the post: [(full image URL, thumbnail URL of 300 px)]. To imageban.ru, which rutracker
    recommends, with IMAGEBAN_KEY (the secret key of an imageban account) in ~/.config/cmus-b2/env, else to
    imgbox.com, which needs no account (fastpic takes no uploads from scripts)."""
    load_env()
    key = os.environ.get("IMAGEBAN_KEY")
    s = requests.Session()
    s.headers["User-Agent"] = "Mozilla/5.0"
    urls = []
    if key:
        for path in paths:
            with open(path, "rb") as f:
                r = s.post("https://api.imageban.ru/v1", headers={"Authorization": f"Bearer {key}"}, timeout=120,
                           data={"p_res": "300"}, files={"image": (os.path.basename(path), f)})
            r.raise_for_status()
            link = r.json()["data"][0]["link"]
            urls.append((link, link.replace("/out/", "/thumbs/")))
        return urls
    csrf = re.search(r'content="([^"]+)" name="csrf-token"', s.get("https://imgbox.com/", timeout=30).text).group(1)
    h = {"X-CSRF-Token": csrf, "X-Requested-With": "XMLHttpRequest"}
    tok = s.post("https://imgbox.com/ajax/token/generate", headers=h, timeout=30).json()
    for path in paths:
        with open(path, "rb") as f:
            r = s.post("https://imgbox.com/upload/process", headers=h, timeout=120,
                       data={"token_id": tok["token_id"], "token_secret": tok["token_secret"], "content_type": "1",
                             "thumbnail_size": "300r", "gallery_id": "null", "gallery_secret": "null",
                             "comments_enabled": "0"},
                       files={"files[]": (os.path.basename(path), f, "image/png" if path.endswith(".png") else "image/jpeg")})
        r.raise_for_status()
        img = r.json()["files"][0]
        urls.append((img["original_url"], img["thumbnail_url"]))
    return urls


def load_env():
    env = os.path.expanduser("~/.config/cmus-b2/env")
    if os.path.exists(env):
        for line in open(env, encoding="utf-8"):
            k, _, v = line.strip().partition("=")
            if k and not k.startswith("#"):
                os.environ.setdefault(k, v.strip().strip("'\""))


