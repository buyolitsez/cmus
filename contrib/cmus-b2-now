#!/usr/bin/env python3
"""One queue in cmus and b2-player, through state/now-playing.json.

Whoever plays writes the tracks played before, the current one, the ones after it and
the position there. Hook it into cmus by adding
    cmus-b2-now "$@" &
to the status_display_program script: on play, pause and track change of a
bucket track it writes the file. While cmus does not play, its status line shows
what the phone plays ("cmus-b2-now --watch"), and play on the same paused track
goes on with what the phone played instead. A track chosen here outside the phone's queue
drops what is left of it from the play queue, so cmus goes on with the chosen album.
A track heard for half its length or 4 minutes goes into state/history.tsv, marked with this computer, as the phone counts its plays.

"cmus-b2-now --resume" does the same at once: it plays the track the file names,
from where it stopped, and puts the rest of that queue into the cmus play queue:
":bind common R shell cmus-b2-now --resume".
"""
import fcntl
import json
import os
import subprocess
import sys
import time

from cmus_b2 import OUT, REMOTE as BUCKET, catalog_tracks, cmus, key_of, query

REMOTE = BUCKET + "/state/now-playing.json"
HISTORY = BUCKET + "/state/history.tsv"
STATE = os.path.join(OUT, "now-playing-status")
# the track playing now and how long it was heard, for the history
LISTEN = os.path.join(OUT, "now-playing-listen.json")
# plays not seen in the bucket yet
PENDING = os.path.join(OUT, "history-pending.tsv")
# the whole shared queue as last written or taken over here, for the tracks played before the current one
SHARED = os.path.join(OUT, "now-playing-shared.json")
# the files a resume put into the cmus play queue
RESUMED = os.path.join(OUT, "now-playing-resumed.json")
QUEUE_MAX, PAST_MAX = 200, 100  # as in the app
DEVICE = "mac" if sys.platform == "darwin" else "arch"


def fetch():
    r = subprocess.run(["rclone", "cat", REMOTE], capture_output=True)
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout else None


def position_now(h, duration):
    """A track still playing on the phone has moved on since the file was written. Past its end,
    the phone stopped without saying so, and the written position is the better guess."""
    moved = (h["position_ms"] + max(0, time.time() * 1000 - h["time"])) / 1000
    return moved if h.get("playing") and moved < duration else h["position_ms"] / 1000


def finished(h, duration):
    """Paused at the end of its track: the phone's queue ran out, nothing there to go on with."""
    return not h.get("playing") and h["position_ms"] / 1000 >= duration - 2


def album_of(tracks, tid):
    d = os.path.dirname(next(t["path"] for i, _, t, _ in tracks if i == tid))
    return [i for i, _, t, _ in tracks if os.path.dirname(t["path"]) == d]


def album_rest(tracks, tid):
    """The tracks after tid on its album."""
    album = album_of(tracks, tid)
    return album[album.index(tid) + 1:]


def save_shared(ids):
    with open(SHARED, "w") as f:
        json.dump(ids, f)


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return []


def played(tid, tracks):
    """The tracks before tid: those of the shared queue when tid is in it, else those of its album."""
    shared = load(SHARED)
    if tid in shared:
        return shared[:shared.index(tid)][-PAST_MAX:]
    album = album_of(tracks, tid)
    return album[:album.index(tid)]


def play_queue():
    path = os.path.join(OUT, "now-playing-queue")
    if os.path.exists(path):
        os.remove(path)
    cmus("-C", f"save -q {path}")
    try:
        with open(path) as f:
            return f.read().splitlines()
    except FileNotFoundError:
        return []


def leave_resumed(tid, file):
    """A track chosen here away from the resumed queue: what is left of that queue in the play queue goes,
    so cmus goes on with the chosen album. A play queue changed by hand since stays."""
    resumed = load(RESUMED)
    if not resumed or file in resumed or tid in load(SHARED):
        return
    files = play_queue()
    if files and files == resumed[-len(files):]:
        cmus("-c", "-q")
    os.remove(RESUMED)


def upcoming(tid, roots, tracks):
    """The tracks after tid as cmus will play them: its play queue, then the rest of the album."""
    ids = {k: i for i, k, _, _ in tracks}
    return [ids[k] for k in (key_of(f, roots) for f in play_queue()) if k in ids] + album_rest(tracks, tid)


def write(past, queue, position, playing):
    tid = queue[0]
    queue = queue[:QUEUE_MAX]
    save_shared(past + queue)
    data = {"version": 1, "track": tid, "past": past, "queue": queue, "position_ms": int(position * 1000), "playing": playing,
            "time": int(time.time() * 1000), "device": DEVICE}
    subprocess.run(["rclone", "rcat", REMOTE], input=json.dumps(data, indent=1, ensure_ascii=False).encode(), check=True)
    # the bucket keeps every version: only the newest one is worth keeping
    d, name = REMOTE.rsplit("/", 1)
    stem, ext = os.path.splitext(name)
    old = subprocess.run(["rclone", "lsf", "--b2-versions", "--files-only", "--include", f"{stem}-v*{ext}", d],
                         capture_output=True, text=True).stdout.split()
    for v in old:
        subprocess.run(["rclone", "deletefile", "--b2-versions", f"{d}/{v}"], capture_output=True)


def listen(tid, duration, playing):
    """Counts a play as the app does: half the track or 4 minutes heard, tracks under 30 s not at all."""
    now = time.time()
    try:
        with open(LISTEN) as f:
            s = json.load(f)
    except (FileNotFoundError, ValueError):
        s = {}
    if s.get("since"):
        s["listened"] += now - s["since"]
    s["since"] = None
    if s.get("tid") and not s["counted"] and s["duration"] >= 30 and s["listened"] >= min(s["duration"] / 2, 240):
        s["counted"] = True
        with open(PENDING, "a") as f:
            f.write(f"{int(s['start'] * 1000)}\t{s['tid']}\t{DEVICE}\n")
    if playing and tid != s.get("tid"):
        s = {"tid": tid, "duration": duration, "start": now, "listened": 0, "counted": False}
    if playing and tid:
        s["since"] = now
    with open(LISTEN, "w") as f:
        json.dump(s, f)
    if os.path.exists(PENDING):
        upload_history()


def upload_history():
    """Adds the plays counted here to state/history.tsv. They stay pending until a later read finds them there,
    so a play lost to the phone writing the file at the same moment goes up again."""
    with open(PENDING) as f:
        pending = f.read().splitlines()
    r = subprocess.run(["rclone", "cat", HISTORY], capture_output=True, text=True)
    if r.returncode != 0:
        return
    there = {tuple(line.split("\t")[:2]) for line in r.stdout.splitlines()}
    missing = [line for line in pending if tuple(line.split("\t")[:2]) not in there]
    if missing:
        text = r.stdout + ("\n" if r.stdout and not r.stdout.endswith("\n") else "") + "".join(f"{line}\n" for line in missing)
        subprocess.run(["rclone", "rcat", HISTORY], input=text.encode(), check=True)
        with open(PENDING, "w") as f:
            f.write("".join(f"{line}\n" for line in missing))
    else:
        os.remove(PENDING)


def hook(args):
    """status_display_program: on play of the paused track go on with what the phone played later,
    write on play and on pause or stop after playing, else tell about the phone."""
    status = args[args.index("status") + 1] if "status" in args else ""
    os.makedirs(OUT, exist_ok=True)
    # one status change at a time, so the uploads land in order
    lock = open(STATE + ".lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    # pgrep of macOS leaves out its ancestors, cmus among them, without -a
    pid = subprocess.run(["pgrep", "-x", "cmus"] + (["-a"] if sys.platform == "darwin" else []),
                         capture_output=True, text=True).stdout.partition("\n")[0]
    try:
        with open(STATE) as f:
            prev_pid, prev_status, prev_file = f.read().rstrip("\n").split(" ", 2)
    except (FileNotFoundError, ValueError):
        prev_pid = prev_status = prev_file = ""
    q = query()
    file = q.get("file", "")
    with open(STATE, "w") as f:
        f.write(f"{pid} {status} {file}\n")
    # Play on the track cmus stood paused on, not a newly chosen one: the phone's queue, when it played later, goes on.
    if status == "playing" and prev_pid == pid and prev_status in ("paused", "stopped") and prev_file == file:
        h = fetch()
        if h and h.get("device") != DEVICE and resume(h, skip_finished=True) == 0:
            return
    if status == "playing" or (prev_pid == pid and prev_status == "playing"):
        key = key_of(file, (q.get("set bucket_dir"), q.get("set download_dir")))
        tracks = list(catalog_tracks()) if key else []
        tid, t = next(((tid, t) for tid, k, t, _ in tracks if k == key), (None, None))
        listen(tid, t and t["duration"], status == "playing")
        if tid:
            if status == "playing":
                leave_resumed(tid, file)
            roots = (q.get("set bucket_dir"), q.get("set download_dir"))
            write(played(tid, tracks), [tid] + upcoming(tid, roots, tracks), float(q.get("position", 0)), status == "playing")
    if status in ("paused", "stopped"):
        # the status line shows what the phone plays until cmus plays again
        subprocess.Popen([sys.argv[0], "--watch"], start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def remote_at(h, tracks):
    """Where the phone is now: (title, artist, duration) and the position, moved on into the next tracks
    of its queue. None well past the end of the written track with nothing written since: it stopped
    without saying so."""
    queue = [tracks[i] for i in h.get("queue", [h["track"]]) if i in tracks]
    if not queue or h["track"] not in tracks:
        return None
    pos = (h["position_ms"] + (max(0, time.time() * 1000 - h["time"]) if h.get("playing") else 0)) / 1000
    if pos > queue[0][2] + 30 or finished(h, queue[0][2]):
        return None
    for t in queue:
        if pos < t[2] or not h.get("playing"):
            return t, pos
        pos -= t[2]
    return None


def watch():
    """While cmus does not play: what the phone plays, in the status line. The position moves on in cmus
    itself; the file is read again as the track ends there, and every 10 s for a pause or a skip."""
    lock = open(os.path.join(OUT, "now-playing-watch.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0  # one watcher is enough
    tracks, catalog_mtime, shown = {}, None, None
    while query().get("status") in ("paused", "stopped"):
        h = fetch()
        line, key = None, None
        # nothing new for an hour: the phone is not about to play
        wait = 15 if h and time.time() * 1000 - h["time"] < 3600_000 else 60
        if h and h.get("device") != DEVICE:
            mtime = os.path.getmtime(os.path.join(OUT, "catalog.json.gz"))
            if mtime != catalog_mtime:
                tracks = {tid: (t["title"], t.get("artist") or al.get("artist", ""), t["duration"]) for tid, _, t, al in catalog_tracks()}
                catalog_mtime = mtime
            at = remote_at(h, tracks)
            if at:
                (title, artist, duration), pos = at
                playing = bool(h.get("playing"))
                line = f"{int(pos)} {int(duration)} {int(playing)} {h['device'].capitalize()} {'▶' if playing else '⏸'} {title} — {artist}"
                key = (h["time"], title)
                if playing:
                    wait = max(1, min(10, duration - pos + 0.5))
        # cmus moves the position on by itself: the same line is not sent again
        if key != shown:
            cmus("-C", f"remote-now {line}" if line else "remote-now")
            shown = key
        time.sleep(wait)
    cmus("-C", "remote-now")
    return 0


def file_of(key, bucket, download):
    """The file cmus plays for a catalog key: the downloaded copy if there is one."""
    if isinstance(key, tuple):
        d = os.path.join(bucket, key[0])
        cues = sorted(n for n in os.listdir(d) if n.lower().endswith(".cue"))
        return f"cue://{os.path.join(d, cues[0])}/{key[1]}"
    local = os.path.join(download, key) if download else ""
    return local if local and os.path.exists(local) else os.path.join(bucket, key)


def resume(h, skip_finished=False):
    if not h:
        cmus("-C", "echo Nothing to continue")
        return 1
    q = query()
    bucket, download = q.get("set bucket_dir", ""), q.get("set download_dir", "")
    tracks = list(catalog_tracks())
    by_id = {tid: (k, t) for tid, k, t, _ in tracks}
    if h["track"] not in by_id:
        cmus("-C", f"echo Not in the catalog: {h['track']}")
        return 1
    key, t = by_id[h["track"]]
    if skip_finished and finished(h, t["duration"]):
        return 1
    save_shared(h.get("past", []) + h.get("queue", [h["track"]]))
    filename = file_of(key, bucket, download)
    position = position_now(h, t["duration"])
    cmus("-C", f"player-play {filename}")
    # over the rclone mount the file takes a moment to open, and a seek before that is lost
    for _ in range(100):
        q = query()
        if q.get("status") == "playing" and q.get("file") == filename:
            break
        time.sleep(0.1)
    cmus("-C", f"seek {int(position)}")
    # The rest of the queue goes into the play queue. cmus goes on with the album after it anyway,
    # so the album's own continuation is left out.
    rest = [i for i in h.get("queue", [])[1:] if i in by_id]
    album = album_rest(tracks, h["track"])
    if rest == album[:len(rest)]:
        rest = []
    elif album and rest[-len(album):] == album:
        rest = rest[:-len(album)]
    cmus("-c", "-q")
    files = [file_of(by_id[i][0], bucket, download) for i in rest]
    if files:
        cmus("-q", *files)
    with open(RESUMED, "w") as f:
        json.dump(files, f)
    return 0


if __name__ == "__main__":
    try:
        if sys.argv[1:2] == ["--watch"]:
            sys.exit(watch())
        sys.exit(resume(fetch()) if sys.argv[1:2] == ["--resume"] else hook(sys.argv[1:]))
    except Exception as e:
        cmus("-C", f"echo cmus-b2-now failed: {e}")
        sys.exit(1)
